{
  "name": "CourseEnrollment",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "status": {
      "type": "string",
      "title": "Enrollment Status",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "enrolled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Enrolled At"
    },
    "last_module_slug": {
      "type": "string",
      "title": "Last Module Slug"
    },
    "pathway": {
      "type": "string",
      "title": "Pathway Focus",
      "description": "Optional. Used by courses that offer more than one pathway, such as Building Wealth Together, to record which pathway the learner is focusing on. It frames the learner's study order and never gates module content.",
      "enum": [
        "entrepreneur",
        "leader",
        "both"
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "progress_percentage": {
      "type": "integer",
      "title": "Progress Percentage",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "certificate_eligible": {
      "type": "boolean",
      "title": "Certificate Eligible",
      "default": false
    },
    "last_check_in_sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Motivational Check-In Sent At"
    },
    "last_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Progress Reminder Sent At"
    },
    "completion_followup_sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completion Follow-Up Sent At"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At"
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "status",
    "enrolled_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}