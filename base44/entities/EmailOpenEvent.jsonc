{
  "name": "EmailOpenEvent",
  "type": "object",
  "properties": {
    "tracking_token": {
      "type": "string",
      "title": "Tracking Token"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "message_type": {
      "type": "string",
      "title": "Message Type",
      "enum": [
        "announcement",
        "follow_up"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "title": "Opened At"
    },
    "open_count": {
      "type": "integer",
      "title": "Open Count",
      "default": 0
    },
    "user_agent": {
      "type": "string",
      "title": "User Agent"
    }
  },
  "required": [
    "tracking_token",
    "recipient_email",
    "message_type",
    "sent_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}