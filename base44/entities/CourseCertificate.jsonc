{
  "name": "CourseCertificate",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "certificate_id": {
      "type": "string",
      "title": "Certificate Identifier"
    },
    "verification_code": {
      "type": "string",
      "title": "Verification Code"
    },
    "learner_name": {
      "type": "string",
      "title": "Learner Name"
    },
    "course_title": {
      "type": "string",
      "title": "Course Title"
    },
    "course_enrollment_id": {
      "type": "string",
      "title": "Course Enrollment ID"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Course Completed At"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "title": "Certificate Issued At"
    },
    "status": {
      "type": "string",
      "title": "Certificate Status",
      "enum": [
        "valid",
        "revoked"
      ],
      "default": "valid"
    },
    "completion_statement": {
      "type": "string",
      "title": "Completion Statement"
    },
    "previous_learner_name": {
      "type": "string",
      "title": "Previous Learner Name",
      "description": "The name on the certificate before an administrator corrected it, retained for audit."
    },
    "corrected_at": {
      "type": "string",
      "format": "date-time",
      "title": "Name Corrected At"
    },
    "corrected_by": {
      "type": "string",
      "title": "Corrected By",
      "description": "The administrator who made the correction."
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "certificate_id",
    "learner_name",
    "course_title",
    "completed_at",
    "issued_at",
    "completion_statement"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}