{
  "name": "CourseCertificate",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "certificate_id": {
      "type": "string",
      "title": "Certificate Identifier"
    },
    "learner_name": {
      "type": "string",
      "title": "Learner Name"
    },
    "course_title": {
      "type": "string",
      "title": "Course Title"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Course Completed At"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "title": "Certificate Issued At"
    },
    "completion_statement": {
      "type": "string",
      "title": "Completion Statement"
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "certificate_id",
    "learner_name",
    "course_title",
    "completed_at",
    "issued_at",
    "completion_statement"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}