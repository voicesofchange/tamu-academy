{
  "name": "WealthCapstone",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "capstone_format": {
      "type": "string",
      "title": "Capstone Option",
      "description": "Which of the course's three capstone options the learner is submitting.",
      "enum": [
        "personal_money_plan",
        "enterprise_plan",
        "group_charter"
      ]
    },
    "title": {
      "type": "string",
      "title": "Capstone Title"
    },
    "content": {
      "type": "string",
      "title": "Capstone Plan",
      "format": "textarea",
      "description": "The learner's written capstone. Stored as a JSON object of section id to response so the numbered sections of the chosen option are preserved."
    },
    "filled_count": {
      "type": "integer",
      "title": "Answered Sections",
      "default": 0,
      "description": "How many capstone sections the learner has answered. Bounded server-side."
    },
    "word_count": {
      "type": "integer",
      "title": "Word Count",
      "description": "Word count of the submitted work, computed server-side."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "First Submitted At"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At"
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "capstone_format",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}