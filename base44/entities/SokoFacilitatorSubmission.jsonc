{
  "name": "SokoFacilitatorSubmission",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "session_plan": {
      "type": "string",
      "title": "Vendor Circle Session Plan",
      "format": "textarea"
    },
    "discussion_summary": {
      "type": "string",
      "title": "Discussion Summary",
      "format": "textarea",
      "description": "A privacy-protecting summary of the discussion facilitated. Participants are never named."
    },
    "reflection": {
      "type": "string",
      "title": "Facilitator Reflection",
      "format": "textarea"
    },
    "consent_confirmed": {
      "type": "boolean",
      "title": "Consent and Privacy Confirmed",
      "default": false,
      "description": "The learner confirms the discussion was held with participants' informed consent and that no personal details are recorded."
    },
    "status": {
      "type": "string",
      "title": "Review Status",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "returned"
      ],
      "default": "draft"
    },
    "reviewer_feedback": {
      "type": "string",
      "title": "Reviewer Feedback",
      "format": "textarea"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At"
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}