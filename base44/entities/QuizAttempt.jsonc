{
  "name": "QuizAttempt",
  "type": "object",
  "properties": {
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "course_slug": {
      "type": "string",
      "title": "Course Slug"
    },
    "module_slug": {
      "type": "string",
      "title": "Module Slug"
    },
    "score": {
      "type": "integer",
      "title": "Score"
    },
    "total_questions": {
      "type": "integer",
      "title": "Total Questions"
    },
    "passed": {
      "type": "boolean",
      "title": "Passed",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted At"
    }
  },
  "required": [
    "learner_id",
    "course_slug",
    "module_slug",
    "score",
    "total_questions",
    "submitted_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.learner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}