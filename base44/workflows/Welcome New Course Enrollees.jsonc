{
  "name": "Welcome New Course Enrollees",
  "description": "When a learner enrolls in a course, sends them a personalized welcome email with a direct link to their first module.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CourseEnrollment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_new_enrollees",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_welcome": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLearnerWelcome",
            "args": {
              "learner_id": "${ .trigger.data.learner_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome email",
            "description": "Personalized greeting to the new enrollee"
          }
        }
      }
    ]
  }
}